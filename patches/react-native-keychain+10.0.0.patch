+/*
+ * `authenticationValidityDuration` - how long (in seconds) a successful biometric/passcode
+ * authentication may be reused before the user is prompted again.
+ *
+ * NOTE (platform asymmetry): on iOS/visionOS the duration is applied PER READ, through an
+ * `LAContext` handed to `SecItemCopyMatching` via `kSecUseAuthenticationContext`, so changing the
+ * option takes effect on the very next read. On Android the equivalent value is baked into the
+ * key at CREATION time (`KeyGenParameterSpec`), so it only affects items stored after the change.
+ *
+ * Returns 0 when the option is absent or not a positive number, in which case callers MUST leave
+ * the keychain query exactly as it was before this option existed.
+ */
+NSTimeInterval authenticationValidityDurationValue(NSDictionary *options)
+{
+  if (options == nil) {
+    return 0;
+  }
+
+  id value = options[@"authenticationValidityDuration"];
+  if (![value isKindOfClass:[NSNumber class]]) {
+    return 0;
+  }
+
+  NSTimeInterval duration = [(NSNumber *)value doubleValue];
+  if (duration <= 0) {
+    return 0;
+  }
+
+  // The OS refuses (and logs) anything above this bound.
+  if (duration > LATouchIDAuthenticationMaximumAllowableReuseDuration) {
+    duration = LATouchIDAuthenticationMaximumAllowableReuseDuration;
+  }
+
+  return duration;
+}
+
+/*
+ * A single `LAContext` shared across reads.
+ *
+ * `touchIDAuthenticationAllowableReuseDuration` only skips the prompt when the *same* context
+ * object is handed to consecutive keychain operations - a freshly allocated context always
+ * re-authenticates. Hence the module-level cache below.
+ *
+ * The reuse window itself is enforced by the OS on the context, not by this code: once more than
+ * `duration` seconds have elapsed since the last successful evaluation, the very same context
+ * will prompt the user again. Keeping the object around therefore cannot grant access beyond the
+ * window. The context is dropped (and `invalidate`d, which also cancels any in-flight prompt)
+ * whenever the requested duration is 0 or differs from the one it was created with.
+ */
+LAContext *reusableAuthenticationContext(NSTimeInterval duration)
+{
+  static LAContext *sharedContext = nil;
+  static NSTimeInterval sharedContextDuration = 0;
+  static dispatch_once_t onceToken;
+  static NSObject *lock = nil;
+  dispatch_once(&onceToken, ^{
+    lock = [NSObject new];
+  });
+
+  @synchronized (lock) {
+    if (duration <= 0) {
+      [sharedContext invalidate];
+      sharedContext = nil;
+      sharedContextDuration = 0;
+      return nil;
+    }
+
+    if (sharedContext == nil || sharedContextDuration != duration) {
+      [sharedContext invalidate];
+      sharedContext = [LAContext new];
+      sharedContextDuration = duration;
+    }
